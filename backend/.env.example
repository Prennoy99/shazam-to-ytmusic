# Copy to .env for local testing:  cp .env.example .env
#
# On a hosting platform (Render, Fly.io, Cloud Run, a VPS...) set these three
# as environment variables in the platform's own dashboard/CLI instead — never
# commit a filled-in .env, it holds your Google session cookies.
#
# Load locally with:  set -a && source .env && set +a
# (`export $(cat .env | xargs)` breaks on the JSON below, which contains
# spaces and commas.)

# Long random string. Generate with: openssl rand -hex 32
API_KEY=changeme

# The playlist you created once by hand in YouTube Music (see README).
# Copy it out of the playlist URL: music.youtube.com/playlist?list=<this part>
PLAYLIST_ID=PLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contents of the browser.json produced by `ytmusicapi browser`, collapsed to
# one line. See README for how to generate it. Single-quote the value here —
# it contains spaces and commas.
YTMUSIC_AUTH_JSON='{"Cookie": "..."}'
