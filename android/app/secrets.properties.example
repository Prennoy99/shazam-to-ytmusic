# Copy to secrets.properties (gitignored) and fill in real values:
#   cp app/secrets.properties.example app/secrets.properties
#
# These become BuildConfig fields baked in at build time. Any key left blank
# builds with a placeholder, and the app will say it isn't configured rather
# than failing in a confusing way later.

# Package name of the YouTube Music client that should play the track.
# Find yours with:  adb shell pm list packages | grep -i music
# Values people have used:
#   app.morphe.android.apps.youtube.music     Morphe (what this was built against)
#   app.revanced.android.apps.youtube.music   ReVanced (varies by patch config)
#   com.google.android.apps.youtube.music     official YouTube Music
targetPackageName=app.morphe.android.apps.youtube.music

# Your deployed backend, no trailing slash.
# e.g. https://<your-service-name>.onrender.com
backendUrl=https://CHANGE-ME.example.com

# Must match the backend's API_KEY environment variable exactly.
backendApiKey=changeme
